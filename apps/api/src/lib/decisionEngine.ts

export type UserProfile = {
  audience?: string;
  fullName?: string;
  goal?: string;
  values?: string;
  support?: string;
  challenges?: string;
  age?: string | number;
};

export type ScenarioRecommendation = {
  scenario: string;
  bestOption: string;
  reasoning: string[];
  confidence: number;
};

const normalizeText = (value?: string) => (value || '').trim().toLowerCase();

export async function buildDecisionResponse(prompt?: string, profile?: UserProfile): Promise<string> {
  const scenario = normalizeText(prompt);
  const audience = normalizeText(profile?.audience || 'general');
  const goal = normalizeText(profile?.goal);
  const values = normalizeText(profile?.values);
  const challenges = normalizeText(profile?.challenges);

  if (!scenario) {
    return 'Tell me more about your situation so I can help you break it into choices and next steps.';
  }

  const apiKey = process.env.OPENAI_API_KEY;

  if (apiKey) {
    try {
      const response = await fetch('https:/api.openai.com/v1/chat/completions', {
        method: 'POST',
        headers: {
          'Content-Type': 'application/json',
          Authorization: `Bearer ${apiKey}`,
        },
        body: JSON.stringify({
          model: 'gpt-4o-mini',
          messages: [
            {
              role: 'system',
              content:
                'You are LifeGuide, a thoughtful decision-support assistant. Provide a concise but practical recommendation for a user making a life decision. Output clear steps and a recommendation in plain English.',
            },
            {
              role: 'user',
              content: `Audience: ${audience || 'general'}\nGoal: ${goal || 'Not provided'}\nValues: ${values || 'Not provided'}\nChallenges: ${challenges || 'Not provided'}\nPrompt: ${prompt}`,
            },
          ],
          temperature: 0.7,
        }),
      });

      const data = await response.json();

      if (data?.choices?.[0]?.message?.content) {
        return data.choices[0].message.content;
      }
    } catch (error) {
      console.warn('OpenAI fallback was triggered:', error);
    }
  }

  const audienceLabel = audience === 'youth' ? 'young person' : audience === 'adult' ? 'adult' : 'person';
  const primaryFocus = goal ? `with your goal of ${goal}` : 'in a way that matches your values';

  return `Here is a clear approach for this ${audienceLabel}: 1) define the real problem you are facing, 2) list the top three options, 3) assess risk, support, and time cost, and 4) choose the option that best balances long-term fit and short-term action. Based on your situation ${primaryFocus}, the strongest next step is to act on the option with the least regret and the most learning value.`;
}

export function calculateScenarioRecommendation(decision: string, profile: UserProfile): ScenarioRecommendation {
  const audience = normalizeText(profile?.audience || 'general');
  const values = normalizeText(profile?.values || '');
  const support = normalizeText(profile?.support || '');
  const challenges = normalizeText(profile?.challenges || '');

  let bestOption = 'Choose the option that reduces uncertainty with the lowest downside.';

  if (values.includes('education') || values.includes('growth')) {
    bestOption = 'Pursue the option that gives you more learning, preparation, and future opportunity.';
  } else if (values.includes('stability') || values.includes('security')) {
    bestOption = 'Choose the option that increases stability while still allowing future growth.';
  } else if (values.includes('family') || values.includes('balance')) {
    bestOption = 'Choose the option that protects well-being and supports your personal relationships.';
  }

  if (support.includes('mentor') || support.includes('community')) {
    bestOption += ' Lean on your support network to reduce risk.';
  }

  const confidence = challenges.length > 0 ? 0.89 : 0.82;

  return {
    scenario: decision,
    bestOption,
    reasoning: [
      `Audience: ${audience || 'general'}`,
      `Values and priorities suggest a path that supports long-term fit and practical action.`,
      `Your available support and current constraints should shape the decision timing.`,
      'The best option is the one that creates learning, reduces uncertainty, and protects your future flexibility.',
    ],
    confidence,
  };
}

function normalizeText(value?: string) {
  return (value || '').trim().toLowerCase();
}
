import 'dotenv/config';
import express, { Request, Response } from 'express';
import cors from 'cors';
import { buildDecisionResponse, calculateScenarioRecommendation } from './lib/decisionEngine';

const app = express();
const port = Number(process.env.PORT || 4000);

app.use(cors());
app.use(express.json());

const profiles: Record<string, any> = {};

app.get('/api/health', (_req: Request, res: Response) => {
  res.json({
    status: 'ok',
    service: 'LifeGuide API',
    timestamp: new Date().toISOString(),
  });
});

app.post('/api/profiles', (req: Request, res: Response) => {
  const profile = req.body;
  const profileId = profile.id || `profile_${Date.now()}`;

  const saved = { ...profile, id: profileId, createdAt: new Date().toISOString() };
  profiles[profileId] = saved;

  res.status(201).json({
    success: true,
    data: saved,
    message: 'Profile saved successfully for LifeGuide analysis.',
  });
});

app.get('/api/profiles/:id', (req: Request, res: Response) => {
  const profile = profiles[req.params.id];

  if (!profile) {
    return res.status(404).json({ success: false, message: 'Profile not found.' });
  }

  return res.json({ success: true, data: profile });
});

app.post('/api/chat', async (req: Request, res: Response) => {
  const { prompt, profile } = req.body;

  try {
    const answer = await buildDecisionResponse(prompt, profile || {});

    return res.json({
      success: true,
      profileSummary: profile || { audience: 'general' },
      reply: answer,
    });
  } catch (error) {
    return res.status(500).json({
      success: false,
      message: 'Unable to generate a response.',
      error: error instanceof Error ? error.message : 'Unknown error',
    });
  }
});

app.post('/api/scenarios/model', (req: Request, res: Response) => {
  const { decision, profile } = req.body || {};

  const result = calculateScenarioRecommendation(decision || 'Career and life transition decision', profile || {});

  return res.json({
    success: true,
    recommendation: result,
  });
});

app.listen(port, () => {
  console.log(`LifeGuide API running on http://localhost:${port}`);
});
