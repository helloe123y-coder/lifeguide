generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id          String   @id @default(cuid())
  fullName    String
  age         Int?
  audience    String
  goal        String?
  values      String?
  support     String?
  challenges  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Scenario {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  createdAt DateTime @default(now())
}
